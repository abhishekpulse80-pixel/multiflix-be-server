{
  "name": "multiflix-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Multiflix API — Node.js + Express + MongoDB (separate from the React Native app)",
  "type": "module",
  "engines": {
    "node": ">= 22.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "seed:users": "tsx src/scripts/seedUsers.ts",
    "seed:posts": "tsx src/scripts/seedPosts.ts",
    "seed:blogs": "tsx src/scripts/seedBlogs.ts",
    "seed:music": "tsx src/scripts/seedMusic.ts",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "reset:admin-passwords": "tsx src/scripts/resetAdminPasswords.ts",
    "seed:earning-rates": "tsx src/scripts/seedEarningRates.ts",
    "backfill:usernames": "tsx src/scripts/backfillUsernames.ts",
    "unset-nickname": "tsx src/scripts/unsetNickname.ts",
    "backfill:music-durations": "tsx src/scripts/backfillMusicDurations.ts",
    "backfill:blog-durations": "tsx src/scripts/backfillBlogDurations.ts",
    "backfill:video-transcoding": "tsx src/scripts/backfillVideoTranscoding.ts",
    "fix:seedkey": "tsx src/scripts/fixSeedKeyIndex.ts",
    "migrate:email-index": "tsx src/scripts/migrateEmailPartialIndex.ts",
    "wipe:music": "tsx src/scripts/wipeMusicData.ts",
    "wipe:all": "tsx src/scripts/wipeAllUserData.ts",
    "seed:open-music": "tsx src/scripts/seedOpenMusic.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.77.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^12.7.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "music-metadata": "^10.7.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.26.1"
  }
}
